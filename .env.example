APP_NAME=eDoc
APP_ENV=production
APP_DEBUG=false
APP_URL=https://edoc.cgmc.gov.kh
ASSET_URL=https://edoc.cgmc.gov.kh

LOCALE=en
APP_INSTALLED=true
DB_SETUP=true
APP_KEY=base64:mHxxw738hic3P/LKITZjxrJiHQkZjZxZt9RY+Q1sZSo=
APP_TIMEZONE=Asia/Phnom_Penh
TIMEZONE=Asia/Phnom_Penh
APP_DEMO=false
VERSION=v1.7.7

VITE_APP_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_document
DB_USERNAME=e_document
DB_PASSWORD=e_document@123

# Live notifications. `reverb` pushes them to the browser as they happen and
# needs the reverb server running (scripts/edoc-reverb.service); `log` only
# writes them to laravel.log and nothing reaches the browser; `null` is off.
BROADCAST_DRIVER=reverb

# php artisan reverb:install generates these, or set your own.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# The hostname the browser connects to, and the port nginx proxies from.
REVERB_HOST=localhost
REVERB_PORT=443
REVERB_SCHEME=https
# What the reverb process itself binds to, behind nginx.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
CACHE_DRIVER=null
FILESYSTEM_DRIVER=local
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=800
SESSION_REMEMBER_LIFETIME=525600
QUEUE_ENABLE=false
# Guards /cron/queue_work when the mail queue is drained from a URL.
CRON_TOKEN=


BROADCAST_CONNECTION="${BROADCAST_DRIVER}"

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=edoc@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=edoc@gmail.com
MAIL_FROM_NAME="eDoc"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=us2

SLACK_ALERT_WEBHOOK=

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

RE_CAPTCHA_KEY=

TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenString
TELEGRAM_CHAT_ID=your_chat_id_here
