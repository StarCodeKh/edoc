+<script setup>
+import { router, Head, usePage, useForm } from '@inertiajs/vue3';
+import Layout from '@/Shared/Layout.vue';
+import { computed } from 'vue';
+
+// Get the settings directly from Inertia's props
+const props = defineProps({
+    settings: Array,
+});
+
+const settingForm = useForm({
+    is_active: props.setting.is_active,
+    email_is_active: props.setting.email_is_active,
+});
+
+function updateSetting() {
+    // settingForm.patch(route('...'), { preserveScroll: true });
+}
+
+// A computed property to watch for success messages from the backend
+const successMessage = computed(() => usePage().props.flash?.success);
+
+// Function to handle the toggle change using Inertia's router
+const updateSetting = (setting, field) => {
+    const newValue = !setting[field];
+
+    router.patch(route('admin.notification-settings.update', setting.id), {
+        [field]: newValue,
+    }, {
+        preserveScroll: true, // Keep the user's scroll position
+        onSuccess: () => {
+            // Optional: Show a success toast. The 'successMessage' computed prop will also update.
+        },
+        onError: (errors) => {
+            // Handle validation errors from the backend
+            alert(Object.values(errors).join(', '));
+        }
+    });
+};
+</script>
+
+<template>
+    <Head title="Notification Manager" />
+
+    <Layout>
+        <template #header>
+            <h2 class="font-semibold text-xl text-gray-800 leading-tight">
+                Notification Manager
+            </h2>
+        </template>
+
+        <div class="py-12">
+            <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
+                <!-- Success message banner -->
+                <div v-if="successMessage" class="mb-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
+                    <span class="block sm:inline">{{ successMessage }}</span>
+                </div>
+
+                <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg">
+                    <div class="p-6 bg-white border-b border-gray-200">
+                        <div class="divide-y divide-gray-200">
+                            <!-- Header Row -->
+                            <div class="grid grid-cols-3 gap-4 font-bold p-4">
+                                <div class="col-span-1">Notification Type</div>
+                                <div class="text-center">In-App Active</div>
+                                <div class="text-center">Email Active</div>
+                            </div>
+
+                            <!-- Settings Rows (props.settings are automatically kept up-to-date by Inertia) -->
+                            <div v-for="setting in props.settings" :key="setting.id" class="grid grid-cols-3 gap-4 items-center p-4 hover:bg-gray-50">
+                                <!-- Notification Name and Description -->
+                                <div class="col-span-1">
+                                    <p class="font-medium text-gray-900">{{ setting.name }}</p>
+                                    <p class="text-sm text-gray-500">{{ setting.description }}</p>
+                                </div>
+
+                                <!-- In-App Toggle -->
+                                <div class="flex justify-center">
+                                    <button @click="updateSetting(setting, 'is_active')"
+                                            :class="[setting.is_active ? 'bg-blue-600' : 'bg-gray-200', 'relative inline-flex flex-shrink-0 h-6 w-11 border-2 border-transparent rounded-full cursor-pointer transition-colors ease-in-out duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500']">
+                                        <span :class="[setting.is_active ? 'translate-x-5' : 'translate-x-0', 'pointer-events-none inline-block h-5 w-5 rounded-full bg-white shadow transform ring-0 transition ease-in-out duration-200']"></span>
+                                    </button>
+                                </div>
+
+                                <!-- Email Toggle -->
+                                <div class="flex justify-center">
+                                    <button v-if="setting.can_be_emailed"
+                                            @click="updateSetting(setting, 'email_is_active')"
+                                            :class="[setting.email_is_active ? 'bg-blue-600' : 'bg-gray-200', 'relative inline-flex flex-shrink-0 h-6 w-11 border-2 border-transparent rounded-full cursor-pointer transition-colors ease-in-out duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500']">
+                                        <span :class="[setting.email_is_active ? 'translate-x-5' : 'translate-x-0', 'pointer-events-none inline-block h-5 w-5 rounded-full bg-white shadow transform ring-0 transition ease-in-out duration-200']"></span>
+                                    </button>
+                                    <span v-else class="text-sm text-gray-400">Not available</span>
+                                </div>
+                            </div>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </div>
+    </Layout>
+</template>
