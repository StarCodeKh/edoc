@@ -0,0 +1,69 @@
+<?php
+namespace App\Notifications;
+
+use App\Models\Comment;
+use Illuminate\Bus\Queueable;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Notifications\Messages\BroadcastMessage;
+use Illuminate\Notifications\Messages\MailMessage;
+use Illuminate\Notifications\Notification;
+
+class NewCommentNotification extends Notification implements ShouldQueue
+{
+    use Queueable;
+
+    public function __construct(public Comment $comment)
+    {
+    }
+
+    public function via(object $notifiable): array
+    {
+        // Add 'mail' channel if email notifications are active for this type
+        $setting = \App\Models\NotificationSetting::where('type', 'new_comment')->first();
+        $channels = ['database', 'broadcast'];
+
+        if ($setting && $setting->email_is_active) {
+            $channels[] = 'mail';
+        }
+
+        return $channels;
+    }
+
+    // For the 'database' channel
+    public function toArray(object $notifiable): array
+    {
+        return [
+            'action_user_id' => $this->comment->user->id,
+            'action_user_name' => $this->comment->user->first_name . ' ' . $this->comment->user->last_name,
+            'project_id' => $this->comment->task->project_id,
+            'project_name' => $this->comment->task->project->title,
+            'task_id' => $this->comment->task_id,
+            'task_title' => $this->comment->task->title,
+            'message' => 'added a new comment.',
+            'url' => route('projects.tasks.show', [$this->comment->task->project_id, $this->comment->task_id]),
+        ];
+    }
+
+    // For the 'broadcast' channel (real-time)
+    public function toBroadcast(object $notifiable): BroadcastMessage
+    {
+        $data = $this->toArray($notifiable);
+        $data['created_at'] = now()->toDateTimeString();
+        $data['read_at'] = null;
+
+        return new BroadcastMessage($data);
+    }
+
+    // For the 'mail' channel
+    public function toMail(object $notifiable): MailMessage
+    {
+        $url = route('projects.tasks.show', [$this->comment->task->project_id, $this->comment->task_id]);
+
+        return (new MailMessage)
+            ->subject('New Comment on Task: ' . $this->comment->task->title)
+            ->line($this->comment->user->first_name . ' ' . $this->comment->user->last_name . ' added a new comment:')
+            ->line('"' . substr($this->comment->details, 0, 100) . '..."')
+            ->action('View Task', $url)
+            ->line('Thank you for using ProTask!');
+    }
+}
