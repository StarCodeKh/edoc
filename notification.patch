+++ b/app/Listeners/SendNewCommentNotification.php
@@ -0,0 +1,40 @@
+<?php
+namespace App\Listeners;
+
+use App\Events\NewCommentAdded;
+use App\Models\NotificationSetting;
+use App\Models\User;
+use App\Notifications\NewCommentNotification;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Support\Facades\Notification;
+
+class SendNewCommentNotification implements ShouldQueue
+{
+    public function handle(NewCommentAdded $event)
+    {
+        // 1. Check if this notification type is active
+        $setting = NotificationSetting::where('type', 'new_comment')->first();
+        if (!$setting || !$setting->is_active) {
+            return;
+        }
+
+        // 2. Eager-load relationships to prevent N+1 query problems
+        $comment = $event->comment->load(['user', 'task.project.workspace.teamMembers', 'task.assignees']);
+        $task = $comment->task;
+        $commenter = $comment->user;
+
+        // 3. Gather all unique users related to the task
+        $usersToNotify = $task->assignees
+            ->merge($task->project->workspace->teamMembers) // Use workspace team members
+            ->push($task->user) // The user who created the task
+            ->unique('id')
+            ->reject(fn (User $user) => $user->id === $commenter->id); // Don't notify the person who made the comment
+
+        if ($usersToNotify->isEmpty()) {
+            return;
+        }
+
+        // 4. Send the notification
+        Notification::send($usersToNotify, new NewCommentNotification($comment));
+    }
+}
