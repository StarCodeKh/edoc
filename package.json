{
    "name": "edoc",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --ssr",
        "format": "prettier --write \"resources/js/**/*.{js,vue}\" \"resources/css/**/*.scss\"",
        "format:check": "prettier --check \"resources/js/**/*.{js,vue}\" \"resources/css/**/*.scss\"",
        "test:browser": "playwright test",
        "test:browser:headed": "playwright test --headed --project=desktop"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/typography": "^0.5.20",
        "vite": "^6.4.3",
        "vite-plugin-node-polyfills": "^0.28.0"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.7.0",
        "@popperjs/core": "^2.11.8",
        "@vitejs/plugin-vue": "^5.0.0",
        "@vue/server-renderer": "^3.5.41",
        "apexcharts": "^3.51.0",
        "autoprefixer": "^10.5.4",
        "axios": "^1.19.0",
        "jsbarcode": "^3.12.3",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^1.0",
        "laravel-vue-i18n": "^2.8.0",
        "lodash": "^4.17.21",
        "lucide-vue-next": "0.544.0",
        "moment": "^2.30.1",
        "moment-duration-format": "^2.3.2",
        "moment-timezone": "^0.5.48",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "^6.2.108",
        "postcss": "^8.5.26",
        "postcss-advanced-variables": "^5.0.0",
        "postcss-import": "^15.1.0",
        "prettier": "^3.9.6",
        "pusher-js": "^8.6.0",
        "sass": "^1.103.1",
        "tailwindcss": "^3.4.19",
        "uuid": "^14.0.2",
        "vite-svg-loader": "^5.1.1",
        "vue": "^3.5.41",
        "vue3-apexcharts": "^1.4.4",
        "vue3-recaptcha2": "^1.8.0",
        "vuedraggable": "^4.1.0"
    },
    "allowScripts": {
        "core-js@3.37.0": true,
        "esbuild@0.25.12": true,
        "fsevents@2.3.3": true,
        "vue-demi@0.13.11": true,
        "yarn@1.22.22": true
